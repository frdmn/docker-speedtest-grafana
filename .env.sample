# Required. Use letters and digits only, e.g. generated with: openssl rand -hex 24
GRAFANA_ADMIN_PASSWORD=
INFLUXDB_PASSWORD=

# Optional
GRAFANA_PORT=3000
# GRAFANA_ANONYMOUS=true        # dashboards viewable without login
# INFLUXDB_ADMIN_PASSWORD=      # empty: generated once and printed in the influxdb log

SPEEDTEST_HOST=local            # tag to tell several runners apart
SPEEDTEST_INTERVAL=3600         # seconds between test runs
# SPEEDTEST_CRON=0 * * * *      # cron schedule instead of the interval, e.g. every full hour
# SPEEDTEST_SERVER=75868,54577  # server IDs, tested one after another (speedtest -L lists nearby ones)
# TZ=Europe/Berlin              # time zone for SPEEDTEST_CRON and log timestamps
