      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb"
          },
          "rawQuery": true,
          "resultFormat": "time_series",
          "query": "SELECT mean(\"download\") FROM \"speedtest\" WHERE \"host\" =~ /^$host$/ AND \"server_name\" =~ /^$server$/ AND $timeFilter GROUP BY time($__interval), \"host\" fill(none)",
          "alias": "$tag_host"
