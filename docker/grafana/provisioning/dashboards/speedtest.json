          "rawQuery": true,
          "resultFormat": "table",
          "query": "SELECT \"download\" AS \"Download\", \"upload\" AS \"Upload\", \"ping\" AS \"Ping\", \"jitter\" AS \"Jitter\", \"packet_loss\" AS \"Packet loss\", \"host\" AS \"Host\", \"server_name\" AS \"Server\", \"isp\" AS \"ISP\", \"result_url\" AS \"Result\" FROM \"speedtest\" WHERE \"host\" =~ /^$host$/ AND \"server_name\" =~ /^$server$/ AND $timeFilter ORDER BY time DESC LIMIT 100"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 1
